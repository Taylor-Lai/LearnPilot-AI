# Application
APP_NAME=LearnPilot Backend
APP_ENV=development
APP_DEBUG=true
APP_PORT=8001
LOG_LEVEL=INFO
CORS_ORIGINS=*
# Set automatically by the container image; local source runs do not need it.
# LEARNPILOT_BACKEND_ROOT=backend

# Database (use sqlite for a zero-setup local run)
DATABASE_MODE=sqlite
SQLITE_DATABASE_URL=sqlite:///./learnpilot.db
MYSQL_ROOT_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=learnpilot
MYSQL_PASSWORD=
MYSQL_DATABASE=learning_agent

# Docker host ports and same-origin browser access
MYSQL_PUBLISHED_PORT=3306
REDIS_PUBLISHED_PORT=6379
ML_PUBLISHED_PORT=8000
BACKEND_PUBLISHED_PORT=8001
WEB_PUBLISHED_PORT=8080
DOCKER_BIND_ADDRESS=127.0.0.1
DOCKER_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Backend-to-ML integration
ML_SERVICE_URL=http://127.0.0.1:8000
USE_ML_SERVICE=true
ML_SERVICE_TIMEOUT_SECONDS=90

# LLM generation
LEARNPILOT_LLM_MODE=template
# Optional: ml/data/processed/oulad after preparing data/external/datasets/oulad
# LEARNPILOT_TRAINING_DATA_DIR=ml/data/processed/oulad
LEARNPILOT_MAX_TRAINING_EVENTS_PER_STUDENT=80
LEARNPILOT_TRAINING_HISTORY_WINDOW=50
# Runtime retraining writes to ml/artifacts; set this only to test a newly trained candidate.
# LEARNPILOT_RANKER_MODEL_DIR=ml/artifacts
# Optional developer override; normal runtime uses the bundled, verified course materials.
# LEARNPILOT_COURSE_SOURCE_DIR=data/external/course-materials/ai-for-beginners
LEARNPILOT_LLM_PROVIDER=spark
SPARK_API_PASSWORD=
SPARK_MODEL=xop3qwen1b7
SPARK_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
SPARK_TIMEOUT_SECONDS=90

# Optional compatibility provider (not the competition default)
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.7-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TIMEOUT_SECONDS=30

# Authentication and jobs
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=1440
REDIS_URL=redis://127.0.0.1:6379/0
PRODUCER_ASYNC_ENABLED=true
PRODUCER_JOB_TIMEOUT_SECONDS=180
